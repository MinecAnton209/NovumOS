# NovumOS default configuration — copy to .config to customize:
#   cp defconfig .config
# Format: CONFIG_<NAME>=y|n|<decimal>. Whole-line comments start with #.
# To disable a default-on option write =n; a "# CONFIG_X is not set"
# line is only a comment and falls back to the schema default.
CONFIG_USE_GARBAGE_COLLECTOR=n
CONFIG_HEAP_INITIAL_SIZE=1048576
CONFIG_HISTORY_SIZE=50
CONFIG_ENABLE_DEBUG_CRASH_COMMANDS=y
CONFIG_ENABLE_DEBUG_COMMANDS=y
CONFIG_ENABLE_EARLY_LFB_DEBUG=n
CONFIG_ENABLE_SERIAL_DEBUG=n
CONFIG_ENABLE_IDT_WATCHDOG=y
CONFIG_ENABLE_RSOD_REBOOT=y
CONFIG_ENABLE_EMBEDDED_ELFS=n
CONFIG_ENABLE_FAT_DEBUG=n
CONFIG_ENABLE_KERNEL_LOGGING=n
CONFIG_ENABLE_SPEAKER=y
CONFIG_ENABLE_BOOT_BEEP=y
CONFIG_ENABLE_ERROR_BEEP=y
CONFIG_NOVA_PATH_POLICY_ENABLED=y
CONFIG_NOVA_DEBUG=y
CONFIG_MOUSE_DEBUG=y
CONFIG_ENABLE_QUANTUM=y
CONFIG_ENABLE_DOOMFIRE=y
CONFIG_ENABLE_BUILTIN_SCRIPTS=y
CONFIG_ENABLE_MOUSE=y
CONFIG_ENABLE_SMP=y
CONFIG_ENABLE_NOVA=y
